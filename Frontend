            [/\b(help|commands|what can i say)\b|मदद|ಸಹಾಯ/, () => announce(t('cmdList'))],
            [/\b(sos|emergency)\b|आपातकाल|ತುರ್ತು/, () => sendSOS()],
            [/\b(read screen)\b|स्क्रीन पढ़ो|ಪರದೆ ಓದು/, readScreen],
            [/\b(speak|bolo)\b|बोलो|ಮಾತನಾಡಿ/, speakSentence],
            [/\b(clear)\b|साफ करो|ತೆರವುಗೊಳಿಸಿ/, () => { sentence = ''; render(); announce(t('cleared')); }],
            [/\b(delete|back)\b|मिटाओ|ಅಳಿಸಿ/, () => { sentence = sentence.slice(0, -1); render(); }],
            [/\b(space)\b/, () => { sentence += ' '; render(); }],
            [/\b(camera on|start camera|camera chalu)\b/, startCamera],
            [/\b(voice off|stop voice)\b/, () => setVoice(false)],
            [/\b(change mode)\b/, goChangeMode],
            [/\b(show screen|full screen|show)\b/, showFull],
            [/\b(big text|bigger text)\b/, toggleFont],
            [/\b(high contrast|contrast)\b/, toggleContrast],
        ];

        function handleVoice(s) {
            if (step === 'gate') { if (/\b(start|begin)\b/.test(s)) $('gateBtn').click(); return; }
            if (step === 'lang') {
                if (/\b(english|one|1)\b/.test(s)) chooseLang('en');
                else if (/\b(hindi|two|2)\b/.test(s)) chooseLang('hi');
                else if (/\b(kannada|three|3)\b/.test(s)) chooseLang('kn');
                return;
            }
            if (step === 'mode') {
                if (/\b(mute|gunga|one|1)\b/.test(s)) chooseMode('mute');
                else if (/\b(deaf|bahira|two|2)\b/.test(s)) chooseMode('deaf');
                else if (/\b(blind|andha|three|3)\b/.test(s)) chooseMode('blind');
                else if (/\b(normal|four|4)\b/.test(s)) chooseMode('normal');
                return;
            }
            for (const [re, fn] of CMDS) if (re.test(s)) { fn(); return; }
            if (MODE === 'blind') {
                sentence += (sentence && !sentence.endsWith(' ') ? ' ' : '') + s;
                render();
                announce(t('added'));
            }
        }
        function readScreen() {
            const msg = `${t('modeIs')}: ${MODE ? t('m_' + MODE) : '—'}. ` +
                (sentence.trim() ? `${t('sentenceIs')}: ${sentence}.` : `${t('noMsg')}.`);
            announce(msg);
        }

        /* ---------- SOS + Helplines (priority) ---------- */
        async function sendSOS() {
            navigator.vibrate?.([400, 150, 400, 150, 400]);
            document.body.classList.add('sos-flash');
            setTimeout(() => document.body.classList.remove('sos-flash'), 1600);
            let msg = t('sosFallback');
            try {
                const r = await fetch('/api/sos', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mode: MODE || 'none' })
                });
                const d = await r.json();
                msg = d.message || msg;
            } catch { }
            loadHelplines();
            $('helpCard').scrollIntoView({ behavior: 'smooth' });
            announce(msg, true);
        }
        $('sosBtn').onclick = sendSOS;
        $('sosTop').onclick = sendSOS;

        async function loadHelplines() {
            try {
                const list = await (await fetch('/api/helplines')).json();
                $('helpList').replaceChildren(...list.map(h => {
                    const row = document.createElement('div'); row.className = 'help';
                    const info = document.createElement('div');
                    const name = document.createElement('b'); name.textContent = h.name;
                    const num = document.createElement('div'); num.textContent = h.number;
                    info.append(name, num);
                    const a = document.createElement('a');
                    a.href = `tel:${h.number}`; a.textContent = '📞 Call';
                    a.setAttribute('aria-label', `Call ${h.name} at ${h.number}`);
                    row.append(info, a);
                    return row;
                }));
            } catch {
                $('helpList').textContent = '112';
            }
        }

        /* ---------- Training ---------- */
        $('captureBtn').onclick = async () => {
            const label = $('label').value.trim().toUpperCase();
            if (!label) { $('trainMsg').textContent = t('trainNeedLabel'); return; }
            if (!latestHands.length) { $('trainMsg').textContent = t('trainNeedHand'); return; }
            let saved = 0, tries = 0;
            $('trainMsg').textContent = `${t('trainCapturing')} "${label}"...`;
            while (saved < 10 && tries < 60) {
                tries++;
                await new Promise(r => setTimeout(r, 250));
                if (!latestHands.length) continue;
                try {
                    const res = await fetch('/api/train', {
                        method: 'POST', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ system: $('system').value, label, landmarks: latestHands[0] })
                    });
                    if (!res.ok) { $('trainMsg').textContent = `${t('trainErr')}: ${await res.text()}`; return; }
                    saved++;
                } catch { $('trainMsg').textContent = t('serverErr'); return; }
            }
            $('trainMsg').textContent = `✔ ${saved} ${t('trainSaved')} "${label}"`;
            refreshStats();
        };

        /* ---------- Analytics ---------- */
        async function refreshStats() {
            try {
                const s = await (await fetch('/api/stats')).json();
                $('sFrames').textContent = s.frames;
                $('sRec').textContent = s.recognized;
                $('sLat').textContent = s.avg_latency_ms;
                $('sLabels').textContent = s.trained_samples;
                $('signNote').textContent = s.trained_samples === 0 ? t('noSigns') : '';
                $('hist').replaceChildren(...s.history.slice().reverse().map(h => {
                    const d = document.createElement('div');
                    d.textContent = `${h.time} · ${h.system} · ${h.label} · ${Math.round(h.confidence * 100)}%`;
                    return d;
                }));
            } catch { }
        }

        /* ---------- Keyboard + blind focus ---------- */
        document.addEventListener('keydown', e => {
            if (e.target.matches('input,select,textarea')) return;
            if (e.altKey) {
                const k = e.key.toLowerCase();
                if (k === 's') sendSOS();
                else if (k === 'v') setVoice(!voiceWanted);
                else if (k === 'm') goChangeMode();
                else if (k === 'h') announce(t('cmdList'));
                return;
            }
            if (step === 'gate' && e.key === 'Enter' && e.target.tagName !== 'BUTTON') { $('gateBtn').click(); return; }
            if (step === 'lang' && LANG_KEYS[e.key]) { chooseLang(LANG_KEYS[e.key]); return; }
            if (step === 'mode' && MODE_KEYS[e.key]) { chooseMode(MODE_KEYS[e.key]); return; }
            if ((e.key === 'r' || e.key === 'R') && lastSpoken) say(lastSpoken);
        });
        document.addEventListener('focusin', e => {
            if (MODE === 'blind' && step === 'app' && e.target.tagName === 'BUTTON') {
                say((e.target.getAttribute('aria-label') || e.target.textContent).trim());
            }
        });

        /* ---------- Init ---------- */
        if (location.protocol === 'file:') {
            $('statusBar').textContent = 'Please open the app at http://localhost:8000 (do not double-click the file).';
        }
        applyI18n();
        showStep('gate');
        loadHelplines();
        refreshStats();
        setInterval(refreshStats, 2000);

