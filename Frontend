<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>SignBridge // Accessible Interface</title>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands@0.4.1675469240/hands.js"></script>

    <style>
        :root {
            --bg: #05060d;
            --glass: rgba(255, 255, 255, .05);
            --line: rgba(255, 255, 255, .18);
            --txt: #eef4ff;
            --c1: #00f5d4;
            --c2: #7b2cff;
            --c3: #ff2e88
        }

        * {
            box-sizing: border-box
        }

        [hidden] {
            display: none !important
        }

        body {
            margin: 0;
            font-family: Inter, system-ui, "Segoe UI", sans-serif;
            background: var(--bg);
            color: var(--txt);
            min-height: 100vh;
            font-size: 16px
        }

        body.mode-mute {
            --c1: #00f5d4;
            --c2: #00b4d8;
            --c3: #7b2cff
        }

        body.mode-deaf {
            --c1: #ffd166;
            --c2: #ff7b00;
            --c3: #ef476f
        }

        body.mode-blind {
            --c1: #c77dff;
            --c2: #4361ee;
            --c3: #f72585
        }

        body.big-text {
            font-size: 20px
        }

        body.hc {
            --bg: #000;
            --glass: #000;
            --line: #ffff00;
            --c1: #ffff00;
            --c2: #fff;
            --c3: #fff
        }

        body.hc::before {
            display: none
        }

        body::before {
            content: "";
            position: fixed;
            inset: -50%;
            z-index: -1;
            background: radial-gradient(circle at 20% 20%, rgba(123, 44, 255, .35), transparent 40%), radial-gradient(circle at 80% 70%, rgba(0, 245, 212, .2), transparent 40%), radial-gradient(circle at 60% 10%, rgba(255, 46, 136, .18), transparent 35%);
            animation: drift 18s ease-in-out infinite alternate
        }

        @keyframes drift {
            to {
                transform: translate(4%, -3%) rotate(6deg)
            }
        }

        @keyframes flash {

            0%,
            100% {
                box-shadow: inset 0 0 0 0 transparent
            }

            50% {
                box-shadow: inset 0 0 0 14px #ff2e88
            }
        }

        body.sos-flash {
            animation: flash .5s 3
        }

        /* overlays (gate, language, mode, full text) */
        .overlay {
            position: fixed;
            inset: 0;
            z-index: 50;
            background: rgba(5, 6, 13, .97);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            overflow: auto
        }

        .stepBox {
            text-align: center;
            max-width: 860px;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px
        }

        .logo {
            font-size: clamp(30px, 6vw, 52px);
            font-weight: 800;
            letter-spacing: 8px;
            background: linear-gradient(90deg, var(--c1), var(--c2), var(--c3));
            -webkit-background-clip: text;
            color: transparent;
            margin: 0
        }

        .tag {
            opacity: .7;
            margin: 0;
            letter-spacing: 2px
        }

        .q {
            font-size: 1.2em;
            margin: 0;
            max-width: 680px;
            line-height: 1.5
        }

        .hint {
            opacity: .65;
            font-size: .9em;
            margin: 0
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 14px;
            width: 100%
        }

        .choice {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            padding: 22px 16px;
            font-size: 1em;
            min-height: 170px;
            text-align: center
        }

        .choice .n {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(90deg, var(--c2), var(--c3));
            color: #fff;
            font-weight: 800
        }

        .choice .ic {
            font-size: 2.2em
        }

        .choice b {
            font-size: 1.1em
        }

        .choice small {
            opacity: .75;
            line-height: 1.4
        }

        /* controls */
        button,
        select,
        input {
            font: inherit;
            color: inherit;
            background: rgba(255, 255, 255, .07);
            border: 2px solid var(--line);
            border-radius: 12px;
            padding: 10px 14px;
            cursor: pointer;
            transition: box-shadow .2s, transform .1s
        }

        button:hover {
            box-shadow: 0 0 18px var(--c2)
        }

        button:active {
            transform: scale(.97)
        }

        button:focus,
        select:focus,
        input:focus,
        a:focus {
            outline: 3px solid #ffff00;
            outline-offset: 2px
        }

        button.primary,
        .bigBtn {
            background: linear-gradient(90deg, var(--c2), var(--c3));
            border: none;
            font-weight: 700
        }

        .bigBtn {
            padding: 18px 40px;
            font-size: 1.2em
        }

        button.sos {
            background: #d00000;
            border: none;
            font-weight: 800;
            letter-spacing: 1px
        }

        button.sos:hover {
            box-shadow: 0 0 22px #ff3b3b
        }

        /* layout */
        header {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: space-between;
            align-items: center;
            padding: 14px 22px;
            border-bottom: 1px solid var(--line);
            backdrop-filter: blur(8px);
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(5, 6, 13, .7)
        }

        .brand,
        .tools {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center
        }

        .logoSm {
            font-size: 20px;
            font-weight: 800;
            letter-spacing: 6px;
            background: linear-gradient(90deg, var(--c1), var(--c2), var(--c3));
            -webkit-background-clip: text;
            color: transparent
        }

        .badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 13px;
            border: 1px solid var(--c1);
            color: var(--c1)
        }

        .badge.on {
            background: var(--c1);
            color: #000
        }

        #statusBar {
            min-height: 28px;
            padding: 10px 22px;
            font-size: 1.05em;
            color: var(--c1)
        }

        .grid {
            display: grid;
            grid-template-columns: 1.4fr 1fr;
            gap: 20px;
            padding: 12px 22px 30px
        }

        @media(max-width:920px) {
            .grid {
                grid-template-columns: 1fr
            }
        }

        .col {
            display: flex;
            flex-direction: column;
            gap: 20px;
            min-width: 0
        }

        .card {
            background: var(--glass);
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 18px;
            backdrop-filter: blur(12px);
            box-shadow: 0 0 30px rgba(0, 245, 212, .07)
        }

        h3 {
            margin: 0 0 12px;
            letter-spacing: 2px;
            font-size: 13px;
            text-transform: uppercase;
            color: var(--c1)
        }

        .row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 12px;
            align-items: center
        }

        .cam {
            position: relative;
            border-radius: 14px;
            overflow: hidden;
            aspect-ratio: 4/3;
            background: #000;
            margin-top: 14px
        }

        .cam video,
        .cam canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: scaleX(-1)
        }

        .hands {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 14px;
            text-align: center
        }

        .big {
            font-size: 58px;
            font-weight: 800;
            text-shadow: 0 0 25px var(--c1);
            min-height: 70px
        }

        .note {
            font-size: .9em;
            opacity: .85;
            min-height: 1em;
            color: #ffd166
        }

        .sentence {
            font-size: 1.3em;
            min-height: 70px;
            word-break: break-word;
            padding: 16px;
            border-radius: 14px;
            background: rgba(0, 0, 0, .4);
            border: 1px solid var(--line)
        }

        .captions {
            font-size: 1.15em;
            min-height: 90px;
            max-height: 220px;
            overflow: auto;
            padding: 12px;
            border-radius: 14px;
            background: #000;
            border: 1px solid var(--line)
        }

        .captions .log {
            opacity: .6;
            font-size: .85em;
            padding: 3px 0
        }

        #captionNow {
            color: var(--c1)
        }

        .help {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            padding: 10px 0;
            border-bottom: 1px dashed var(--line)
        }

        .help a {
            background: linear-gradient(90deg, #00b894, #00f5d4);
            color: #000;
            text-decoration: none;
            padding: 8px 14px;
            border-radius: 10px;
            font-weight: 700
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px
        }

        .stat {
            padding: 14px;
            border-radius: 14px;
            background: rgba(0, 0, 0, .3);
            border: 1px solid var(--line);
            font-size: .85em
        }

        .stat b {
            display: block;
            font-size: 1.8em;
            color: var(--c1)
        }

        .hist {
            max-height: 200px;
            overflow: auto;
            font-family: ui-monospace, monospace;
            font-size: .85em;
            margin-top: 12px
        }

        .hist div {
            padding: 6px 0;
            border-bottom: 1px dashed var(--line)
        }

        #fullText {
            background: #05060d;
            flex-direction: column;
            gap: 24px
        }

        #bigText {
            font-size: min(14vw, 160px);
            font-weight: 800;
            text-align: center;
            word-break: break-word;
            color: var(--c1);
            text-shadow: 0 0 30px var(--c1)
        }

        .small {
            font-size: .85em;
            opacity: .75
        }
    </style>
</head>

<body class="mode-mute">

    <!-- Step 1: Gate (speech ke liye user click zaroori hai) -->
    <div id="gate" class="overlay">
        <div class="stepBox">
            <h1 class="logo">SIGNBRIDGE</h1>
            <p class="tag">SIGN · SPEAK · CONNECT</p>
            <button class="bigBtn" id="gateBtn">
                <span>Start SignBridge</span>
            </button>
            <p class="hint">Press Enter or click. Voice control starts after this.</p>
        </div>
    </div>

    <!-- Step 2: Language choice -->
    <div id="langStep" class="overlay" hidden>
        <div class="stepBox">
            <h2 style="margin:0;letter-spacing:3px">Language</h2>
            <p class="q" id="langQ"></p>
            <div class="cards">
                <button class="choice" data-lang="en"><span class="n">1</span><span
                        class="ic">Aa</span><b>English</b></button>
                <button class="choice" data-lang="hi"><span class="n">2</span><span class="ic">अ</span><b>हिन्दी
                        (Hindi)</b></button>
                <button class="choice" data-lang="kn"><span class="n">3</span><span class="ic">ಅ</span><b>ಕನ್ನಡ
                        (Kannada)</b></button>
            </div>
        </div>
    </div>

    <!-- Step 3: Mode choice -->
    <div id="modeStep" class="overlay" hidden>
        <div class="stepBox">
            <h2 style="margin:0;letter-spacing:3px" data-i18n="modeTitle">Which option describes you?</h2>
            <p class="q" id="modeQ"></p>
            <div class="cards">
                <button class="choice" data-mode="mute"><span class="n">1</span><span class="ic">🤟</span><b
                        data-i18n="m_mute"></b><small data-i18n="d_mute"></small></button>
                <button class="choice" data-mode="deaf"><span class="n">2</span><span class="ic">👂</span><b
                        data-i18n="m_deaf"></b><small data-i18n="d_deaf"></small></button>
                <button class="choice" data-mode="blind"><span class="n">3</span><span class="ic">🦯</span><b
                        data-i18n="m_blind"></b><small data-i18n="d_blind"></small></button>
                <button class="choice" data-mode="normal"><span class="n">4</span><span class="ic">🙂</span><b
                        data-i18n="m_normal"></b><small data-i18n="d_normal"></small></button>
            </div>
        </div>
    </div>

    <!-- Full screen text (doosron ko dikhane ke liye) -->
    <div id="fullText" class="overlay" hidden>
        <div id="bigText"></div>
        <button id="closeFull"><span data-i18n="close">Close</span></button>
    </div>

    <!-- Main app -->
    <div id="app" hidden>
        <header>
            <div class="brand">
                <span class="logoSm">SIGNBRIDGE</span>
                <span class="badge" id="conn">OFFLINE</span>
                <span class="badge" id="modeBadge">—</span>
            </div>
            <div class="tools">
                <select id="langSel" aria-label="Language">
                    <option value="en">English</option>
                    <option value="hi">हिन्दी</option>
                    <option value="kn">ಕನ್ನಡ</option>
                </select>
                <button id="voiceTop" aria-label="Voice on or off"><span></span></button>
                <button id="changeMode"><span data-i18n="changeMode">Change mode</span></button>
                <button id="fontBtn"><span data-i18n="font">A+ Font</span></button>
                <button id="contrastBtn"><span data-i18n="contrast">High contrast</span></button>
                <button class="sos" id="sosTop" aria-label="SOS emergency">🆘 <span
                        data-i18n="sosTop">SOS</span></button>
            </div>
        </header>
        <p id="statusBar" role="status" aria-live="polite"></p>

        <main class="grid">
            <div class="col">
                <section class="card" id="camCard">
                    <div class="row" style="margin-top:0">
                        <select id="system" aria-label="Sign language">
                            <option value="ASL">American Sign Language (ASL)</option>
                            <option value="ISL">Indian Sign Language (ISL)</option>
                        </select>
                        <button class="primary" id="startBtn"><span></span></button>
                        <span class="badge" id="handBadge">—</span>
                        <span class="badge" id="fps">0 fps</span>
                    </div>
                    <div class="cam">
                        <video id="video" playsinline muted></video>
                        <canvas id="overlay"></canvas>
                    </div>
                    <div class="hands">
                        <div><small>HAND 1</small>
                            <div class="big" id="letter0">·</div><span class="badge" id="conf0">—</span>
                        </div>
                        <div><small>HAND 2</small>
                            <div class="big" id="letter1">·</div><span class="badge" id="conf1">—</span>
                        </div>
                    </div>
                    <p class="note" id="signNote"></p>
                </section>

                <section class="card">
                    <h3 data-i18n="msgLabel">Your message</h3>
                    <div class="sentence" id="sentence" aria-live="polite"></div>
                    <div class="row">
                        <button id="speakBtn">🔊 <span data-i18n="speak">Speak</span></button>
                        <button id="showBtn">📺 <span data-i18n="show">Show</span></button>
                        <button id="spaceBtn"><span data-i18n="space">Space</span></button>
                        <button id="delBtn">⌫ <span data-i18n="del">Delete</span></button>
                        <button id="clearBtn"><span data-i18n="clear">Clear</span></button>
                    </div>
                </section>
            </div>

            <aside class="col">
                <section class="card" id="helpCard">
                    <h3 data-i18n="helpTitle">Helpline desk</h3>
                    <button class="sos" id="sosBtn" style="width:100%;margin-bottom:12px"
                        aria-label="Request emergency help">🆘 <span data-i18n="sosBtn">SOS</span></button>
                    <div id="helpList"></div>
                </section>

                <section class="card">
                    <h3 data-i18n="capLabel">Voice & captions</h3>
                    <button id="voiceBtn" style="width:100%"><span></span></button>
                    <div class="captions" id="captions" role="log" aria-live="polite" style="margin-top:12px">
                        <div id="captionNow" class="small" data-i18n="capEmpty"></div>
                    </div>
                </section>

                <section class="card">
                    <h3 data-i18n="analyticsTitle">Live analytics</h3>
                    <div class="stats">
                        <div class="stat"><b id="sFrames">0</b><span data-i18n="frames">frames</span></div>
                        <div class="stat"><b id="sRec">0</b><span data-i18n="recognized">recognized</span></div>
                        <div class="stat"><b id="sLat">0</b><span data-i18n="latency">latency</span></div>
                        <div class="stat"><b id="sLabels">0</b><span data-i18n="samples">samples</span></div>
                    </div>
                    <div class="hist" id="hist"></div>
                </section>

                <section class="card">
                    <h3 data-i18n="trainTitle">Teach a sign</h3>
                    <div class="row" style="margin-top:0">
                        <input id="label" maxlength="12" data-i18n-ph="trainLabelPh" placeholder="Label, e.g. A"
                            aria-label="Sign label">
                        <button id="captureBtn"><span data-i18n="capture">Capture 10 frames</span></button>
                    </div>
                    <p id="trainMsg" class="small"></p>
                </section>
            </aside>
        </main>
    </div>

