// 1. Gesture states ko track karne ke variables
let lastWristY = 0;
let isFistDetected = false;
let nodCount = 0;
let lastNodTimestamp = 0;

// 2. ISL "YES" Detection Logic Function
function detectIndianSignLanguageYes(landmarks) {
    if (!landmarks || landmarks.length < 21) return false;

    // Check if fingers are closed (Fist Shape)
    const isIndexClosed  = landmarks[8].y  > landmarks[6].y;
    const isMiddleClosed = landmarks[12].y > landmarks[10].y;
    const isRingClosed   = landmarks[16].y > landmarks[14].y;
    const isPinkyClosed  = landmarks[20].y > landmarks[18].y;

    const currentFist = isIndexClosed && isMiddleClosed && isRingClosed && isPinkyClosed;

    const currentWristY = landmarks[0].y;
    const currentTime = Date.now();
    let gestureTriggered = false;

    if (currentFist) {
        if (isFistDetected && lastWristY !== 0) {
            const movementY = currentWristY - lastWristY; // Upar-neeche ka movement
            
            // Agar hath ko neeche jhatka diya (Nodding action)
            if (movementY > 0.015 && (currentTime - lastNodTimestamp > 200)) {
                nodCount++;
                lastNodTimestamp = currentTime;
                
                if (nodCount >= 1) { 
                    gestureTriggered = true;
                    nodCount = 0; 
                }
            }
        }
        isFistDetected = true;
    } else {
        isFistDetected = false;
        if (currentTime - lastNodTimestamp > 1000) {
            nodCount = 0;
        }
    }

    lastWristY = currentWristY;
    return gestureTriggered;
}

// 3. MediaPipe Setup aur Results Callback Loop
// (Ye aapke cdn script se 'Hands' class ko initialize karega)
const handsInstance = new Hands({
  locateFile: (file) => `https://jsdelivr.net{file}`
});

handsInstance.setOptions({
  maxNumHands: 1,
  modelComplexity: 1,
  minDetectionConfidence: 0.6,
  minTrackingConfidence: 0.6
});

// Jab bhi camera frames se hand detect hoga, ye function chalega
handsInstance.onResults((results) => {
  if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
      const landmarks = results.multiHandLandmarks[0]; // Pehla hath select kiya
      
      // Check karein kya "YES" sign bana hai
      const isYes = detectIndianSignLanguageYes(landmarks);
      
      if (isYes) {
          console.log("ISL YES Detected!");
          
          // Aapke UI ke Status bar me text change karega
          const statusBar = document.getElementById("statusBar");
          if(statusBar) statusBar.innerText = "Detected Sign: YES (Haan)";
          
          // Aapke main UI ke screen box me text add karega
          const sentenceBox = document.querySelector(".sentence");
          if(sentenceBox) {
              // Purane text me "Yes" jod dega
              sentenceBox.innerText += " Yes"; 
          }
      }
  }
});

